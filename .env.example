# --- Database ---
# Postgres with pgvector. For docker-compose use host "db" instead of localhost.
DATABASE_URL=postgresql+psycopg://langchain:langchain@localhost:5432/langchain

# --- LLM / embeddings ---
# Groq console: https://console.groq.com/keys (chat LLM)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Embeddings come from any OpenAI-compatible /v1/embeddings API (required —
# serverless can't run local models). Together: https://api.together.xyz/settings
EMBEDDINGS_BASE_URL=https://api.together.xyz/v1
EMBEDDINGS_API_KEY=
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# --- Telegram ---
# Token from @BotFather. Leave empty to run API-only.
TELEGRAM_BOT_TOKEN=
# Your Telegram user id — this user becomes platform admin (owner of everything).
TELEGRAM_ADMIN_ID=0
# Random string; must match the secret_token passed to setWebhook.
TELEGRAM_WEBHOOK_SECRET=dev-secret-change-me
# disabled | polling (local dev) | webhook (production, needs a public URL)
BOT_MODE=disabled
# e.g. https://myapp.example.com — required when BOT_MODE=webhook
WEBHOOK_URL=

# --- REST API ---
# Comma-separated keys for X-API-Key authentication.
API_KEYS=dev-api-key-1

# --- RAG tuning ---
OFF_TOPIC_DISTANCE=0.95
HISTORY_WINDOW=8
UPLOAD_DIR=data/uploads
